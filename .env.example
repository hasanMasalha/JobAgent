DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
REDIS_URL=
PYTHON_SERVICE_URL=

# Internal service-to-service auth — lets the Python service call back into
# Next.js (daily match emails, application confirmation emails) without a
# user session. Must be set identically on both services.
INTERNAL_API_KEY=
# Base URL the Python service uses to reach Next.js for those callbacks.
# In docker-compose this must be the service name, not localhost:
# NEXTJS_URL=http://nextjs:3000
NEXTJS_URL=
# Serper API key for Google search (free: serper.dev)
SERPER_API_KEY=

# 2captcha — automatic captcha solving for ATS forms (reCAPTCHA v2 / hCaptcha)
# Sign up at https://2captcha.com, add credit, copy API key
TWOCAPTCHA_API_KEY=

# Google Calendar Integration
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Production:
# GOOGLE_REDIRECT_URI=https://jobagent.uk/api/auth/google/callback
